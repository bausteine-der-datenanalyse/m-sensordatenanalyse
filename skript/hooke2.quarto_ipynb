        "  plt.legend([errorbar_container.lines[0], errorbar_container.lines[2][0]],\n",
        "             ['Mittelwert', 'Standardfehler'],\n",
        "             loc = 'upper left')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
